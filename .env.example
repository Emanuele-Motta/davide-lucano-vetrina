# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FEATURE TOGGLE: CALENDARIO & PRENOTAZIONE ONLINE
# Imposta a "false" per disattivare completamente il calendario, il form di prenotazione e tutte le CTA di booking,
# convertendo il sito in modalita contatto diretto telefonico / WhatsApp con il Dott. Davide Lucano.
# Imposta a "true" per abilitare il calendario interattivo e le prenotazioni online.
VITE_ENABLE_BOOKING="true"
VITE_CAL_LINK="nomeutente/visita"

# ==============================================================================
# 🎛️ CONFIGURAZIONE SEZIONI SITO (NETLIFY ENVIRONMENT VARIABLES)
# ==============================================================================
# Puoi attivare ("true") o disattivare ("false") qualsiasi sezione del sito
# direttamente dalla dashboard di Netlify (Site configuration > Environment variables).
# Quando una sezione è disattivata, scompare istantaneamente dalla pagina,
# dalla barra di navigazione in alto e dal piè di pagina.

# VISIBILITÀ DELLE SEZIONI (true = visibile, false = nascosta)
VITE_SECTION_HERO="true"       # Sezione iniziale di presentazione (titolo, ccta, foto)
VITE_SECTION_ABOUT="true"      # Sezione "Chi Sono & Metodo Clinico"
VITE_SECTION_SERVICES="true"   # Sezione "Trattamenti Specializzati"
VITE_SECTION_TERRITORY="true"  # Sezione "Zone Servite" (Milano Sud, Rozzano, Opera...)
VITE_SECTION_REVIEWS="true"    # Sezione "Recensioni & Opinioni MioDottore"
VITE_SECTION_BOOKING="true"    # Sezione "Prenotazione & Calendario Visite"
VITE_SECTION_LOCATION="true"   # Sezione "Dove Siamo & Orari Studio"
VITE_SECTION_FAQ="true"        # Sezione "FAQ / Domande Frequenti" (consigliato tenerla ultima)

# ORDINAMENTO POSIZIONE DELLE SEZIONI (numero intero crescente: 10, 20, 30...)
# Le sezioni vengono visualizzate in ordine dal numero più basso al più alto.
VITE_ORDER_HERO="10"
VITE_ORDER_ABOUT="20"
VITE_ORDER_SERVICES="30"
VITE_ORDER_TERRITORY="40"
VITE_ORDER_REVIEWS="50"
VITE_ORDER_BOOKING="60"
VITE_ORDER_LOCATION="70"
VITE_ORDER_FAQ="80"

# PIÈ DI PAGINA (FOOTER)
# Imposta a "true" se desideri mostrare il box disclaimer medico/fiscale nel footer.
VITE_SHOW_FOOTER_DISCLAIMER="false"

# ==============================================================================
# 🏥 DATI CLINICI E CONTATTI DELLO STUDIO (NETLIFY CONFIGURABLE)
# ==============================================================================
# Se non specificate, verranno utilizzati i valori predefiniti di siteConfig.ts
VITE_DOCTOR_NAME=""
VITE_DOCTOR_TITLE=""
VITE_DOCTOR_ALBO=""
VITE_STUDIO_NAME=""
VITE_STUDIO_PHONE=""
VITE_STUDIO_WHATSAPP=""
VITE_STUDIO_EMAIL=""
VITE_STUDIO_PEC=""
VITE_STUDIO_PIVA=""
VITE_STUDIO_ADDRESS=""
VITE_STUDIO_CITY=""
VITE_STUDIO_CAP=""
VITE_STUDIO_PROVINCE=""
VITE_FORM_ENDPOINT=""
VITE_MIODOTTORE_URL=""
VITE_GA_MEASUREMENT_ID=""

# RECENSIONI (server-side Netlify Functions; non usare il prefisso VITE_ per le chiavi)
# Crea una API key Google limitata a Places API e configurala come secret Netlify.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
# Solo URL di un feed JSON ufficiale/autorizzato fornito da Docplanner/MioDottore.
MIODOTTORE_REVIEWS_FEED_URL=""

# ==============================================================================
# GOOGLE CALENDAR INTEGRATION (DOTT. DAVIDE LUCANO)
# ==============================================================================
# Se queste variabili non sono configurate, l'app opera automaticamente in modalità fallback locale sicura.
# Inserire l'ID del calendario Google del cliente (es. dott.davidelucano@gmail.com o id calendario specifico)
VITE_GOOGLE_CALENDAR_ID=""

# Chiave API Google Cloud con abilitazione alla Google Calendar API (per verifica disponibilità/FreeBusy)
VITE_GOOGLE_API_KEY=""

# Client ID OAuth 2.0 Google (per sincronizzazione eventi bidirezionale)
VITE_GOOGLE_CLIENT_ID=""

